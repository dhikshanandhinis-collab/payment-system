{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bell-recon:schemas:settlement_record:1.0",
  "title": "Processor settlement (funding) file line (synthetic)",
  "description": "Published to processor.settlement.events by ingestion/settlement_adapter.py, one event per line of a processor settlement CSV. Kafka key = payment_id. gross_amount and fee_amount are non-negative magnitudes; net_amount is signed from the merchant's point of view: +gross for CAPTURE/CHARGEBACK_REVERSAL, -gross for REFUND/REVERSAL/CHARGEBACK, minus fee_amount.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "source_system", "event_time", "correlation_id",
               "settlement_id", "settlement_batch_id", "settlement_date", "processor_transaction_id", "payment_id",
               "transaction_type", "gross_amount", "fee_amount", "net_amount", "currency"],
  "properties": {
    "event_id": {"$ref": "#/$defs/identifier"},
    "event_type": {"const": "SETTLEMENT_LINE"},
    "schema_version": {"const": "1.0"},
    "source_system": {"const": "processor_settlement"},
    "event_time": {"type": "string", "format": "date-time", "description": "Start of the settlement date in the business timezone (deterministic, so re-reading a file reproduces identical events)."},
    "correlation_id": {"$ref": "#/$defs/identifier", "description": "The settlement file batch identifier."},
    "settlement_id": {"$ref": "#/$defs/identifier", "description": "Unique per settled transaction; re-sent lines reuse it."},
    "settlement_batch_id": {"$ref": "#/$defs/identifier"},
    "settlement_date": {"type": "string", "format": "date"},
    "processor_transaction_id": {"$ref": "#/$defs/identifier"},
    "payment_id": {"$ref": "#/$defs/identifier"},
    "transaction_type": {"enum": ["CAPTURE", "REFUND", "REVERSAL", "CHARGEBACK", "CHARGEBACK_REVERSAL"]},
    "gross_amount": {"$ref": "#/$defs/amount"},
    "fee_amount": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$"},
    "net_amount": {"type": "string", "pattern": "^-?(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$"},
    "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$", "not": {"pattern": "^0(\\.0{1,2})?$"}}
  }
}
