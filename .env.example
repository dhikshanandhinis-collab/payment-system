# Local development configuration. Copy to .env:  cp .env.example .env  (PowerShell: Copy-Item .env.example .env)
# All values below are PLACEHOLDERS for a local, synthetic-data environment. Replace every password,
# and never reuse these values outside your machine. Production secrets belong in a secret manager.

ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- PostgreSQL ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=recon
DB_SCHEMA_NAME=recon
DB_SSLMODE=disable
# Superuser: used ONLY by the postgres container and the one-shot db-init / test services.
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=replace-me-superuser-local-only
# Migration (DDL owner) role: used only by db-init.
DB_MIGRATOR_USER=recon_migrator
DB_MIGRATOR_PASSWORD=replace-me-migrator-local-only
# Runtime least-privilege role used by all services.
DB_USER=recon_app
DB_APP_USER=recon_app
DB_PASSWORD=replace-me-app-local-only
# Read-only reporting role.
DB_REPORTING_USER=recon_reporting
DB_REPORTING_PASSWORD=replace-me-reporting-local-only
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ---- Kafka -----------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
TOPIC_PARTITIONS=6
TOPIC_REPLICATION_FACTOR=1
TOPIC_MIN_INSYNC_REPLICAS=1
TOPIC_RETENTION_MS=604800000
TOPIC_DLQ_RETENTION_MS=2592000000
INGESTION_CONSUMER_GROUP=recon-ingestion
INGESTION_AUTO_OFFSET_RESET=earliest
INGESTION_BATCH_SIZE=500
INGESTION_POLL_TIMEOUT_S=1.0

# ---- Retry -----------------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=6
RETRY_INITIAL_BACKOFF_S=0.5
RETRY_MAX_BACKOFF_S=10

# ---- Reconciliation / business ---------------------------------------------------------------
BUSINESS_TIMEZONE=America/Toronto
RECON_WORKER_BATCH_SIZE=100
RECON_SWEEP_INTERVAL_S=10
BATCH_DAILY_RUN_TIME=00:30
BATCH_INTRADAY_INTERVAL_S=900
# Comma-separated synthetic operator identities allowed to run audited admin commands.
ADMIN_ALLOWED_ACTORS=ops.alice,ops.bob

# ---- Simulation (synthetic data only) --------------------------------------------------------
SIM_SEED=20261028
SIM_RUN_ID=local
SIM_PAYMENTS_PER_SECOND=2
SIM_DECLINE_RATE=0.06
SIM_MISSING_PROCESSOR_RATE=0.005
SIM_MISSING_LEDGER_RATE=0.008
SIM_PROCESSOR_AMOUNT_MISMATCH_RATE=0.004
SIM_LEDGER_AMOUNT_MISMATCH_RATE=0.004
SIM_DUPLICATE_DELIVERY_RATE=0.02
SIM_DELAYED_EVENT_RATE=0.05
SIM_INVALID_PAYLOAD_RATE=0.003
SIM_REFUND_RATE=0.03
SIM_REVERSAL_RATE=0.01
SIM_INTERRUPTION_PROBABILITY_PER_MINUTE=0.02

# ---- Optional observability profile ----------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=replace-me-grafana-local-only

# ---- Production only (docker-compose.prod.yml) -----------------------------------------------
# On the VM also set: ENVIRONMENT=production, SIM_RUN_ID=prod and a lower SIM_PAYMENTS_PER_SECOND
# (e.g. 0.5) so disk growth stays manageable; watch the DiskSpaceLow alert during the first days.
# Alert e-mail via SMTP (for Gmail: smtp.gmail.com:587 with an App Password, not your login password).
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@example.com
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-me-smtp-password
ALERT_EMAIL_TO=you@example.com
# Nightly pg_dump target on the host and retention in days. Copy dumps off the VM periodically.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_S=86400
