# Copy to terraform.tfvars (git-ignored) and fill in. Values come from the Oracle Cloud console:
#   Profile > My profile > API keys > Add API key  (download the private key; the dialog shows the OCIDs,
#   fingerprint and region).
tenancy_ocid     = "ocid1.tenancy.oc1..replace-me"
user_ocid        = "ocid1.user.oc1..replace-me"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "C:/Users/replace-me/.oci/oci_api_key.pem"
region           = "ap-mumbai-1" # must be your HOME region for Always Free A1 capacity

repo_url = "https://github.com/dhikshanandhinis-collab/payment-system.git"

# Alert e-mail. Gmail: smtp.gmail.com:587 + an App Password (Google account > Security > App passwords), no spaces.
smtp_smarthost = "smtp.gmail.com:587"
smtp_from      = "you@gmail.com"
smtp_username  = "you@gmail.com"
smtp_password  = "replace-me-app-password"
alert_email_to = "you@gmail.com"
